[template]default[/template]

[region=aside]

<div class="webforms-aside">
  <h3>Webforms</h3>

  <div class="webforms-mode">
    <strong>Mode</strong>
    <div>Design / Deploy</div>
  </div>

  <div class="webforms-design-placeholder">
    <h4>Design Mode</h4>
    <ul>
      <li>Toolkit placeholder</li>
      <li>Field palette placeholder</li>
      <li>Properties placeholder</li>
    </ul>
  </div>

  <div class="webforms-deploy-placeholder">
    <h4>Deploy Mode</h4>
    <ul>
      <li>Catalog placeholder</li>
      <li>Collection navigation placeholder</li>
    </ul>
  </div>
</div>

[/region]

[region=content]

$content

<div class="webforms-content">
  <section class="webforms-design-workspace-placeholder">
    <h3>Design Mode</h3>
    <p>An inert grid/snap workspace for composing JSON-defined forms will appear here.</p>
    <p>No JSON authoring behavior is active yet.</p>
  </section>

  <section class="webforms-deploy-view-placeholder">
    <h3>Deploy Mode</h3>
    <p>Selected JSON-composed webforms will render here after the runtime is implemented.</p>
    <p>No deployed webform behavior is active yet.</p>
  </section>
</div>

[/region]

[region=right_aside]

[widget=notifications][/widget]

[widget=newmember][/widget]

[/region]
