[template]default[/template]

[region=aside]

<div class="webforms-aside">
  <h3>Webforms</h3>

  <div class="webforms-mode-selector">
    <strong>Mode</strong>
    <div class="btn-group btn-group-sm mt-2 mb-3" role="group" aria-label="Webforms mode placeholder">
      <button type="button" class="btn btn-primary" disabled="disabled">Design</button>
      <button type="button" class="btn btn-outline-secondary" disabled="disabled">Deploy</button>
    </div>
  </div>

  <div class="webforms-design-tools">
    <h4>Design</h4>
    <ul>
      <li>Toolkit</li>
      <li>Field palette</li>
      <li>Properties</li>
    </ul>
  </div>

  <hr>

  <div class="webforms-deploy-navigation">
    <h4>Deploy</h4>
    <ul>
      <li>Catalog</li>
      <li>Collections</li>
      <li>Webforms</li>
    </ul>
  </div>
</div>

[/region]

[region=content]

$content

<div class="webforms-content">
  <section class="webforms-design-workspace-placeholder">
    <h3>Design workspace</h3>
    <p>This area will become an inert grid/snap workspace for composing JSON-defined forms.</p>
    <div class="well">
      Grid / snap workspace placeholder
    </div>
  </section>

  <section class="webforms-deploy-view-placeholder">
    <h3>Deploy preview</h3>
    <p>Selected JSON-composed webforms will render here after the runtime is implemented.</p>
    <p>No deployed webform behavior is active yet.</p>
  </section>
</div>

[/region]

[region=right_aside]

[widget=notifications][/widget]

[widget=newmember][/widget]

[/region]
