[template]default[/template]

[region=aside]

<div class="webforms-aside">
  <h3>Webforms</h3>

  <div class="webforms-mode-selector">
    <strong>Mode</strong>
    <div class="btn-group btn-group-sm mt-2 mb-3" role="group" aria-label="Webforms mode">
      <a class="btn btn-outline-secondary" href="webforms?mode=design">Design</a>
      <a class="btn btn-outline-secondary" href="webforms?mode=deploy">Deploy</a>
    </div>
  </div>

  <div class="webforms-design-tools">
    <h4>Design</h4>
    <ul>
      <li>Toolkit</li>
      <li>Field palette</li>
      <li>Properties</li>
    </ul>
  </div>

  <hr>

  <div class="webforms-deploy-navigation">
    <h4>Deploy</h4>
    <ul>
      <li>Catalog</li>
      <li>Collections</li>
      <li>Webforms</li>
    </ul>
  </div>
</div>

[/region]

[region=content]

$content

[/region]

[region=right_aside]

[widget=notifications][/widget]

[widget=newmember][/widget]

[/region]
